# Public site and business
SITE_URL=http://localhost:3000
WHATSAPP_BUSINESS_NUMBER=919353193080
BUSINESS_NAME=WOW RIGHT

# Protected admin — use a unique email, strong password and 32+ character secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional AI. Leave the API key blank and the storefront remains fully usable.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
# Required only when saving an API key through Admin. Must be stable base64 for 32 bytes.
# Generate once with: openssl rand -base64 32
AI_SETTINGS_ENCRYPTION_KEY=
DELIVERY_OTP_SECRET=

# Customer authentication and transactional email (server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
# A verified Resend sender, for example: WOW RIGHT <orders@wowright.in>
EMAIL_FROM=

# Optional external analytics
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Current Graph API version supported by your Meta account (vNN.N).
META_API_VERSION=
# Optional Events Manager test code; remove before live campaigns.
META_TEST_EVENT_CODE=
NEXT_PUBLIC_GA_ID=

# Optional future payment configuration (no gateway is called in V1)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
